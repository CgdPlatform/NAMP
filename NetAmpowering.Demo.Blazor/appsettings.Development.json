{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "SamplingProbability": 1.0
  },
  "Pyroscope": {
    "ApplicationName": "namp-ampowering",
    "Enable": true,
    "EnableAllocationTracking": true,
    "EnableContentionTracking": true,
    "EnableExceptionTracking": true
  }
}
