<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <!-- Configuration NetAmpowering : memes cles que appsettings.json (.NET 8) -->
    <add key="OpenTelemetry:Enabled" value="true" />
    <add key="OpenTelemetry:ApplicationName" value="demo-mvc5" />
    <add key="OpenTelemetry:SamplingProbability" value="1.0" />
    <add key="OpenTelemetry:OtlpEndpoint" value="http://localhost:4318/v1/traces" />
    <add key="OpenTelemetry:OtlpMetricsEndpoint" value="http://localhost:9090/api/v1/otlp/v1/metrics" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2">
      <assemblies>
        <!-- Requis pour compiler les .aspx/.cshtml qui touchent des types exposes par une lib netstandard2.0 -->
        <add assembly="netstandard, Version=2.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51" />
      </assemblies>
    </compilation>
    <!-- OBLIGATOIRE : sans cela Activity.Current est perdu apres un await -->
    <httpRuntime targetFramework="4.7.2" />
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
