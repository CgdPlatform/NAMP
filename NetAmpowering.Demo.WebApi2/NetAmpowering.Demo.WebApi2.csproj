<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Demo ASP.NET Web API 2 (.NET Framework 4.7.2) : projet SDK-style qui compile dans bin\ et
    s'execute directement sous IIS Express (voir README.md).
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>NetAmpowering.Demo.WebApi2</RootNamespace>
    <AssemblyName>NetAmpowering.Demo.WebApi2</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NetAmpoweringUpdateBindingRedirects>true</NetAmpoweringUpdateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetAmpowering.AspNet" Version="1.1.0" />
    <PackageReference Include="NetAmpowering.AspNet.WebApi" Version="1.0.0" />
    <PackageReference Include="NetAmpowering.Observability.EntityFramework6" Version="1.0.0" />
    <PackageReference Include="NetAmpowering.Coverage.AspNet" Version="1.0.0" />
    <!-- Le weaver Fody : instrumente les methodes a la compilation (couverture de code en production) -->
    <PackageReference Include="NetAmpowering.Coverage" Version="1.1.0" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.9.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.Configuration" />
    <None Include="FodyWeavers.xml" />
  </ItemGroup>

</Project>
